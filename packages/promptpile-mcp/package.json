{
  "name": "promptpile-mcp",
  "version": "0.1.0-beta.3",
  "description": "Promptpile 与 MCP：stdio 会话 + 本机 HTTP 网关（launch / export-tools / exec-calls / check）",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lithdoo/promptpile.git",
    "directory": "packages/promptpile-mcp"
  },
  "homepage": "https://github.com/lithdoo/promptpile#readme",
  "bugs": {
    "url": "https://github.com/lithdoo/promptpile/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "tag": "beta"
  },
  "bin": {
    "promptpile-mcp": "dist/src/index.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test dist/src/architecture-boundary.test.js dist/src/version.test.js dist/src/mcp-config.test.js dist/src/mcp/tool-name.test.js dist/src/http/execution.test.js dist/src/http/mcp-backend.test.js dist/src/exec-calls/check-status.test.js dist/src/exec-calls/execution-claim.test.js dist/src/exec-calls/post-exec.test.js dist/src/exec-calls/scan-call-files.test.js dist/src/exec-calls/write-result-jsonl.test.js dist/src/commands/exec-calls.test.js dist/src/commands/layered-output-boundary.test.js",
    "test:smoke": "npm run build && npm run mcp:smoke",
    "test:packed": "npm run build && node dist/scripts/packed-smoke.js",
    "test:integration": "npm run build && node dist/scripts/integration-smoke.js",
    "prepack": "npm run build",
    "mcp:smoke": "node dist/scripts/mcp-smoke.js",
    "start": "node dist/src/index.js",
    "dev": "ts-node src/index.ts"
  },
  "keywords": [
    "promptpile-mcp",
    "promptpile",
    "mcp",
    "model-context-protocol",
    "command-line"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "type": "commonjs",
  "files": [
    "dist",
    "README.md",
    "docs/after-hook.example.sh",
    "test-fixtures/stdio-server.cjs",
    "package.json"
  ],
  "dependencies": {
    "promptpile-protocol": "0.1.0-beta.2",
    "@iarna/toml": "^2.2.5",
    "@koa/router": "^12.0.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^14.0.3",
    "koa": "^2.16.4",
    "koa-bodyparser": "^4.4.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/koa": "^3.0.2",
    "@types/koa__router": "^12.0.5",
    "@types/koa-bodyparser": "^4.3.13",
    "ts-node": "^10.9.2",
    "@types/node": "^25.5.2",
    "typescript": "~5.9.3"
  }
}
