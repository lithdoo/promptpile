{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lithdoo/promptpile/blob/main/doc/15-contracts/completion-receipt-v1.schema.json",
  "title": "Promptpile Completion Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "invocationId", "artifacts", "model", "finishReason", "usage", "hook"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "status": { "const": "completed" },
    "invocationId": { "oneOf": [{ "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" }, { "type": "null" }] },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assistant", "calls", "extra", "mainOutput", "mainCalls", "mainExtra"],
      "properties": {
        "assistant": { "$ref": "#/$defs/pathOrNull" },
        "calls": { "$ref": "#/$defs/pathOrNull" },
        "extra": { "$ref": "#/$defs/pathOrNull" },
        "mainOutput": { "$ref": "#/$defs/pathOrNull" },
        "mainCalls": { "$ref": "#/$defs/pathOrNull" },
        "mainExtra": { "$ref": "#/$defs/pathOrNull" }
      }
    },
    "model": { "type": "string" },
    "finishReason": { "type": ["string", "null"] },
    "usage": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["inputTokens", "outputTokens", "totalTokens"],
          "properties": {
            "inputTokens": { "type": "integer", "minimum": 0 },
            "outputTokens": { "type": "integer", "minimum": 0 },
            "totalTokens": { "type": "integer", "minimum": 0 }
          }
        },
        { "type": "null" }
      ]
    },
    "hook": { "$ref": "#/$defs/hook" }
  },
  "$defs": {
    "pathOrNull": { "type": ["string", "null"] },
    "failureMode": { "enum": ["warn", "error"] },
    "hook": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["status", "failureMode", "reason"],
          "properties": {
            "status": { "const": "skipped" },
            "failureMode": { "$ref": "#/$defs/failureMode" },
            "reason": { "enum": ["not_configured", "default_not_found"] }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["status", "failureMode", "attempted", "reason"],
          "properties": {
            "status": { "const": "invalid_explicit" },
            "failureMode": { "$ref": "#/$defs/failureMode" },
            "attempted": { "type": "string" }, "reason": { "type": "string" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["status", "failureMode", "path", "exitCode"],
          "properties": {
            "status": { "const": "succeeded" },
            "failureMode": { "$ref": "#/$defs/failureMode" },
            "path": { "type": "string" }, "exitCode": { "const": 0 }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["status", "failureMode", "path"],
          "properties": {
            "status": { "const": "spawn_failed" },
            "failureMode": { "$ref": "#/$defs/failureMode" },
            "path": { "type": "string" }, "errorCode": { "type": "string" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["status", "failureMode", "path", "exitCode"],
          "properties": {
            "status": { "const": "exited_nonzero" },
            "failureMode": { "$ref": "#/$defs/failureMode" },
            "path": { "type": "string" }, "exitCode": { "type": "integer" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["status", "failureMode", "path", "signal"],
          "properties": {
            "status": { "const": "signaled" },
            "failureMode": { "$ref": "#/$defs/failureMode" },
            "path": { "type": "string" }, "signal": { "type": "string" }
          }
        }
      ]
    }
  }
}
